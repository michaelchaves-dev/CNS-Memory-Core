# Copy this file to .env and update the values for local development
# Never commit your real .env file
#
# CNS_API_KEY is required. The server will refuse to start without it.
# Keep this key on the hosting platform / server only — never in browser JS,
# NEXT_PUBLIC_*, VITE_*, or any client-visible config.

CNS_API_KEY=your-strong-secret-key-here-change-this-in-production
REDIS_URL=redis://localhost:6379/0
